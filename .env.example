BOT_TOKEN=
ADMIN_ID=
DB_PATH=arbitrage.sqlite3
SCAN_INTERVAL=45
NOTIONAL_USD=5
MAX_BOOK_AGE_SEC=12
# Публичные WebSocket-стаканы: опционально; реальные ордера не включаются.
PUBLIC_BOOK_STREAMS=false
PUBLIC_STREAM_MAX_SYMBOLS=40
PUBLIC_STREAM_MAX_AGE_SEC=1.5
# Семплированная история: один последний WS-снимок пары за интервал.
PUBLIC_STREAM_RECORD_INTERVAL_SEC=1
MIN_ESTIMATED_EDGE_PCT=1.5
EXCHANGES=binance,bybit,okx,bitget,gateio,mexc,bingx
PAPER_CAPITAL_USD=50
MAX_PAPER_POSITIONS=2
PAPER_ENTRY_EDGE_PCT=2.0
PAPER_TARGET_CONVERGENCE=0.70
PAPER_TRAILING_DRAWDOWN=0.20
PAPER_MAX_SECONDS=1200
UNIVERSE_SIZE=120
SCAN_BATCH_SIZE=30
SCAN_CONCURRENCY=8
SAFETY_BUFFER_PCT=0.10
DAILY_STOP_PCT=2.0
MAX_ENGINE_ERRORS=3

# Optional private read-only API credentials. Withdrawals must stay disabled.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSWORD=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSWORD=
GATEIO_API_KEY=
GATEIO_API_SECRET=
MEXC_API_KEY=
MEXC_API_SECRET=
BINGX_API_KEY=
BINGX_API_SECRET=

# LIVE stays physically disabled until final validation.
LIVE_ENABLED=false
# Разрешение write-side автовыхода на проверенных площадках; пусто = наблюдение.
# Нужны LIVE_ENABLED, снятый STOP и свежая private-сверка. Входы это не включает.
LIVE_EXIT_VENUES=
PRIVATE_ORDER_STREAMS=false
# Новые реальные IOC-входы: отдельный запуск после release/venue acceptance.
LIVE_ENTRY_ENABLED=false
# Spot/Futures использует общие LIVE/ENTRY флаги и отдельные strategy/account
# checks в acceptance. false запрещает новые SF-входы, не наблюдение/выход.
LIVE_SPOT_FUTURES_ENABLED=true
LIVE_CAPITAL_USD=50
LIVE_ACCEPTANCE_PATH=live_acceptance.json
RUNTIME_STATE_PATH=runtime_state.json

# Micro-live remains locked unless all evidence gates pass
LIVE_MAX_OPEN_TRADES=1
LIVE_MAX_BOOK_AGE_MS=1500
LIVE_MAX_SLIPPAGE_PCT=0.20
LIVE_MIN_NET_EDGE_USD=0.05
LIVE_NO_WITHDRAW_ATTESTED=false

LIVE_METRICS_PATH=live_metrics.json

# Optional 0x indicative prices only, no wallet transactions.
ZEROX_API_KEY=
DEX_RESEARCH_ROUTES_JSON=[]

# Read-only reconciliation loop; does not enable exchange writes.
LIVE_RECONCILE_INTERVAL_SEC=10

# Виртуальные запасы Spot/Spot. Пусто = только наблюдения, без Paper-входов.
# Каждая монета: qty и price (USDT reference), весь резерв входит в общий PAPER_CAPITAL_USD.
# Пример: {"binance":{"USDT":10},"bybit":{"assets":{"BTC":{"qty":0.0001,"price":100000}}}}
PAPER_SPOT_INVENTORY_JSON={}

# Funding Paper: горизонт 8 часов; forecast не зачисляется как выплаты.
FUNDING_PAPER_HOLD_SECONDS=28800
FUNDING_PAPER_MIN_CARRY_PCT=0.03

# Публичные REST-стаканы для offline-проверок; максимум 200000 строк / 72 часа.
RECORD_PUBLIC_BOOKS=true
BOOK_HISTORY_MAX_ROWS=200000
BOOK_HISTORY_HOURS=72

# Separate strategy entry gates; root LIVE and expiring account acceptance still apply
LIVE_SPOT_SPOT_ENABLED=true
LIVE_FUNDING_ENABLED=true
LIVE_FUNDING_HOLD_SECONDS=28800
LIVE_FUNDING_MIN_CARRY_PCT=0.03

# Read-only firm DEX quote/RPC simulation, no signer or transactions
DEX_SIMULATION_ROUTES_JSON=[]
DEX_SIMULATION_RPC_URL=
DEX_TOKEN_REGISTRY_PATH=dex_token_registry.json
# Read-only counterfactual Paper hold; does not submit swaps or CEX orders.
DEX_PAPER_HOLD_SECONDS=900
# Distinct HTTPS endpoints: receipt observation and explicitly configured DEX runtime.
DEX_WALLET_RPC_PRIMARY=
DEX_WALLET_RPC_SECONDARY=
# Automatic DEX mainnet entry/paired exit. Requires root LIVE, scoped certificates,
# isolated wallet, funded inventory and existing verified allowance. No auto-approve.
DEX_LIVE_ENABLED=false
DEX_WALLET_POLICY_PATH=dex_wallet_policy.json
DEX_WALLET_PRIVATE_KEY=
# Raw asset amounts, verified registry tokens only; budget capped at 5 USDT.
DEX_LIVE_ROUTES_JSON=[]
DEX_MAX_UNHEDGED_SECONDS=900
